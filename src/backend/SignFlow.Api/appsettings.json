{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=SignFlowDb_Dev;Integrated Security=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "https://legaldesk.tn",
    "Audience": "https://legaldesk.tn",
    "ExpirationMinutes": 15
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "uploads"
  },
  "Email": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromEmail": "noreply@legaldesk.tn",
    "FromName": "LegalDesk"
  },
  "Groq": {
    "ApiKey": "",
    "Model": "openai/gpt-oss-120b",
    "MaxTokens": 1000,
    "AnalysisModel": "openai/gpt-oss-120b",
    "AnalysisMaxTokens": 8000,
    "AnalysisMaxInputChars": 48000
  },
  "Ai": {
    "Provider": "None"
  },
  "LocalLlm": {
    "BaseUrl": "http://localhost:11434/v1",
    "Model": "qwen2.5:7b",
    "AnalysisModel": null,
    "MaxTokens": 1000,
    "AnalysisMaxTokens": 3000,
    "AnalysisMaxInputChars": 12000,
    "AnalysisTimeoutSeconds": 900
  },
  "LegalCorpus": {
    "BaseUrl": "http://127.0.0.1:8100",
    "ApiKey": null,
    "TimeoutSeconds": 120
  },
  "Review": {
    "TimeoutSeconds": 120
  },
  "Seal": {
    "CertificatePath": null,
    "CertificatePassword": null,
    "TimestampUrl": "http://timestamp.digicert.com",
    "AllowTestCertificate": true
  },
  "Ocr": {
    "Enabled": true,
    "TesseractPath": "tesseract",
    "PdftoppmPath": "pdftoppm",
    "Languages": "fra+eng+ara",
    "Dpi": 300,
    "PageTimeoutSeconds": 60
  },
  "Security": {
    "PublicUrl": "http://localhost:4200",
    "RequireMfaForPrivilegedRoles": true,
    "KnownProxies": [],
    "ClamAv": {
      "Host": "",
      "Port": 3310,
      "Required": true
    }
  },
  "AllowedOrigins": "http://localhost:4200,http://localhost:3000",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/legaldesk-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
